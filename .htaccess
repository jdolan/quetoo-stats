RewriteEngine On

# Route /api/stats/<guid> -> api/stats.php?guid=<guid>
RewriteRule ^api/stats/([a-f0-9]{64})/?$ api/stats.php?guid=$1 [L,QSA]

# Route /api/<name> -> api/<name>.php
RewriteRule ^api/([a-z_]+)/?$ api/$1.php [L,QSA]

# Route /deploy -> deploy.php
RewriteRule ^deploy/?$ deploy.php [L]

# Route /analytics -> analytics.php
RewriteRule ^analytics/?$ analytics.php [L]

# Block direct access to config files
<FilesMatch "^config.*\.php$">
  Require all denied
</FilesMatch>

# The analytics dashboard is the only page here that reads the sessions table,
# so it is the only one behind a password. AuthUserFile lives outside the
# document root and is created by install.sh, never committed.
<Files "analytics.php">
  AuthType Basic
  AuthName "Quetoo analytics"
  AuthUserFile /etc/apache2/quetoo-stats.htpasswd
  Require valid-user
</Files>
